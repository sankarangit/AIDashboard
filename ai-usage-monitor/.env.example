# Copy to .env. Leave provider keys empty to run the labeled demo dashboard.
APP_ENV=local
DATABASE_URL=sqlite:///./data/usage.db
BIND_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://127.0.0.1:8000
DEFAULT_TIMEZONE=Asia/Singapore
REQUIRE_AUTH=false
API_AUTH_TOKEN=
SCHEDULER_ENABLED=false

# Provider credentials. Never commit real values. Regular chat subscriptions are not these keys.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=

# Optional. Used only when you already run LiteLLM and choose to import its spend logs.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Alerts stay off until both flags are set. No mail is sent by default.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional JSON map of currency -> USD rate, used only for a labeled combined outlay.
# Example: {"SGD":0.74}
FX_USD_RATES=
